    { "id": "high-mkfs", "command": "mkfs.ext4 /dev/sda1", "kind": "high" },
    { "id": "high-risk-badge", "command": "df -h", "riskLevel": "high", "kind": "high" },

    { "id": "interactive-top", "command": "top", "kind": "interactive" },
