    { "id": "write-malformed-sudo", "command": "sudo -u", "kind": "write" },

    { "id": "high-command-substitution", "command": "echo \"$(touch /tmp/x)\"", "kind": "high" },
    { "id": "high-backticks", "command": "echo \"`touch /tmp/x`\"", "kind": "high" },
    { "id": "high-process-substitution", "command": "cat <(touch /tmp/x)", "kind": "high" },
    { "id": "high-newline", "command": "ls\ntouch /tmp/x", "kind": "high" },
    { "id": "high-prompt-expansion", "command": "echo \"${payload@P}\"", "kind": "high" },
    { "id": "high-reboot", "command": "reboot", "kind": "high" },
