    { "id": "write-journal-follow", "command": "journalctl -f", "kind": "write" },
    { "id": "write-journal-relinquish", "command": "journalctl --relinquish-var=yes", "kind": "write" },
    { "id": "write-dmesg-short-clear", "command": "dmesg -c", "kind": "write" },
